# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Site ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example-devcura.com
NEXT_PUBLIC_SITE_NAME=Devcura

# Authentication ------------------------------------------------------------
# Random string, minimum 32 characters. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# First administrator, used only by `npx tsx src/db/seed.ts`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-passphrase
ADMIN_NAME=Site Administrator

# Contact / email -----------------------------------------------------------
# NOTE: email delivery is NOT implemented yet (see src/lib/mailer.ts).
# Enquiries are stored in PostgreSQL and shown in /admin/inquiries.
CONTACT_EMAIL=hello@example-devcura.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
